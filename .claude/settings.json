{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/deploy-retrigger-guard.sh"
          }
        ],
        "description": "空コミット・自動コミット生成・空コミットpushをブロック（GitHubフラグ再発防止・恒久ルール）"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/secret-scan.sh"
          }
        ],
        "description": "コミット前にシークレット漏洩（APIキー・パスワード・トークン）を検出してブロック"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/commit-msg-check.sh"
          }
        ],
        "description": "コミットメッセージが Conventional Commits 規約に準拠しているか検証（警告のみ）"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/git-push-reminder.sh"
          }
        ],
        "description": "git push 前にブランチ・コミット数を表示し、force push を警告"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/suggest-compact.sh"
          }
        ],
        "description": "ツール呼び出し50回ごとに戦略的コンパクション (/compact) を提案"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/console-log-warn.sh"
          }
        ],
        "description": "JS/TS ファイル編集後に console.log / debugger の残留を警告"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/session-learning-capture.sh"
          }
        ],
        "description": "セッション学習ログが未作成の場合にリマインド（git commit 時）"
      }
    ]
  }
}
