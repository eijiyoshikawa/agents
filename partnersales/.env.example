# PartnerSales 環境変数
# すべて未設定でも seed データでビルド・開発が可能。
# Supabase を設定すると自動的に DB バックエンドに切り替わる（lib/db/index.ts）。

# Supabase プロジェクト URL（ブラウザにも露出してよい）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon キー（ブラウザ用。登録フォームの RPC 呼び出しに使用）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role キー（サーバ／ビルド時のみ。絶対にブラウザへ出さない）
SUPABASE_SERVICE_ROLE_KEY=

# Notion 連携トークン（サーバ／スクリプト用）。設定すると Notion DB へ同期可能になる
NOTION_TOKEN=

# 静的サイトの basePath（GitHub Pages 等で配信する場合）
NEXT_PUBLIC_BASE_PATH=
