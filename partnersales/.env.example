# PartnerSales 環境変数
# すべて未設定でも seed データでビルド・開発が可能。
# Supabase を設定すると自動的に DB バックエンドに切り替わる（lib/db/index.ts）。

# Supabase プロジェクト URL（ブラウザにも露出してよい）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon キー（ブラウザ用。登録フォームの RPC 呼び出しに使用）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role キー（サーバ／ビルド時のみ。絶対にブラウザへ出さない）
SUPABASE_SERVICE_ROLE_KEY=

# Notion 連携トークン（サーバ用）。設定すると登録時に Notion DB へ自動同期される
NOTION_TOKEN=

# セッション署名用シークレット（必須・推測されない十分長いランダム文字列）
#   生成例: openssl rand -base64 32
AUTH_SESSION_SECRET=

# スタッフ管理画面 /admin の合言葉（スタッフログインで使用）
STAFF_PASSPHRASE=

# メール送信（Resend）。登録時にログイン情報をパートナーへ送る。未設定なら画面表示にフォールバック
#   RESEND_API_KEY: https://resend.com で取得
#   EMAIL_FROM: 認証済みドメインの送信元（例: PartnerSales <no-reply@your-domain.jp>）
RESEND_API_KEY=
EMAIL_FROM=

# 本番URL（メール本文のログインリンク用。例: https://partnersales-xxxx.vercel.app）
APP_URL=
