# ===== 認証（Auth.js v5） =====
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → OAuth クライアント（Web）。リダイレクトURI: https://<hub host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== 共通セッション（各ダッシュボードと共有） =====
# 各アプリと同じ値を設定する。CRON_SECRET とは必ず別の値にする。
HUB_SESSION_SECRET=
# 親ドメイン。先頭ドットで全サブドメインに Cookie を共有する（例: .let-inc.net）。
# 未設定の場合はハブ自身のホストにのみ Cookie を発行する（ローカル開発用）。
HUB_COOKIE_DOMAIN=
# Cookie 有効期間（秒）。既定 7 日。ハブを開くたびに延長される。
HUB_SESSION_TTL_SECONDS=604800

# ===== メンバー判定 =====
# config/members.json に無いメールでも、このドメインの Google アカウントなら staff として許可する（任意）。
HUB_ALLOWED_DOMAIN=

# ===== 各ダッシュボードの URL（未設定時は config/dashboards.json の defaultUrl） =====
HUB_URL_FINANCE=https://finance.let-inc.net
HUB_URL_SALES=https://sales.let-inc.net
HUB_URL_JINJI=https://jinji.let-inc.net
HUB_URL_KPI=https://kpi.let-inc.net/kpi
HUB_URL_HYOKA=https://hyoka.let-inc.net
HUB_URL_CONSOLE=
