# ===== 認証（Auth.js v5） =====
# openssl rand -base64 32
AUTH_SECRET=

# メールアドレス + パスワード認証。メンバーは config/members.json、パスワードのハッシュはここ。
# 値は JSON オブジェクト（メール → ハッシュ）。ハッシュは `node scripts/hash-password.mjs <email>` で生成する。
# 例: {"a@let-inc.net":"scrypt$16384$...$...","b@let-inc.net":"scrypt$16384$...$..."}
HUB_PASSWORD_HASHES=

# （任意）Google ログイン。両方設定した場合のみログイン画面に Google ボタンが出る。未設定なら不要。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# （任意・Google ログイン専用）members.json に無いメールでも、このドメインの Google アカウントなら staff として許可する。
HUB_ALLOWED_DOMAIN=

# ===== 共通セッション（各ダッシュボードと共有） =====
# openssl rand -base64 32。各アプリと同じ値を設定する。CRON_SECRET とは必ず別の値にする。
HUB_SESSION_SECRET=
# 親ドメイン。先頭ドットで全サブドメインに Cookie を共有する。
HUB_COOKIE_DOMAIN=.let-inc.net
# Cookie 有効期間（秒）。既定 7 日。ハブを開くたびに延長される。
HUB_SESSION_TTL_SECONDS=604800

# ===== 各ダッシュボードの URL（未設定時は config/dashboards.json の defaultUrl = 現在の vercel.app URL） =====
# サブドメインを付与したものから順に切り替える。
HUB_URL_FINANCE=
HUB_URL_SALES=
HUB_URL_JINJI=
HUB_URL_KPI=
HUB_URL_OPS=
HUB_URL_HYOKA=
HUB_URL_CONSOLE=
