# ── Notion 連携 ────────────────────────────────────────────────
# 1) https://www.notion.so/my-integrations で内部インテグレーションを作成し、
#    "Internal Integration Secret" をここに貼る（ntn_ で始まる文字列）
# 2) 下記の各データベースを開き、右上「...」→「コネクト」→ 作成したインテグレーションを追加
NOTION_TOKEN=

# 各DBのID（既定値は株式会社LET公式Notionの実DB。別環境ならここを差し替える）
# 📊 DB_顧客管理（顧客マスタ・ファネル・電話番号）
NOTION_DB_CUSTOMERS=1ac3fae4-3499-4991-b465-e375bef7d66c
# 📞 架電記録（顧客に紐づく実架電ログ）
NOTION_DB_CALLS=f2a72c62-21ed-4de5-acb0-00848c9b0cbe
# 🤝 契約管理DB（MRR・契約・継続）
NOTION_DB_CONTRACTS=b079ca72-2a13-4562-96d6-cd83b4787bbd
# 📞 IS架電KPI（月次目標つき架電ログ）※任意
NOTION_DB_ISKPI=f9fa0d32-3eb1-4625-9f4a-e06cc0cedb6b

# ── クリック発信 ───────────────────────────────────────────────
# 電話番号クリック時に使うURIスキーム。既定は tel:（OSの既定電話アプリ＝Zoom Phoneを既定にすれば発信される）。
# Zoom 専用スキームを使いたい場合は callto などに変更可。
NEXT_PUBLIC_CALL_SCHEME=tel

# キャッシュ再検証間隔（秒）。会議直前でも最新にしたい場合は短めに。
NOTION_REVALIDATE_SECONDS=300
