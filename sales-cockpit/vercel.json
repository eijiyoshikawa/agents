{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/warm",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/weekly-summary",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/daily-summary",
      "schedule": "15 9 * * 1-5"
    },
    {
      "path": "/api/job-scan",
      "schedule": "*/30 * * * *"
    }
  ]
}
