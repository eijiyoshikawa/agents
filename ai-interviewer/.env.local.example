# ============================================================
# AI Interviewer — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in real values.
# Do NOT commit `.env.local` (it is gitignored).
#
# All values below are intentionally empty. The comment on each
# line documents the format / where to obtain the key.

# ----- Anthropic (Claude) -----
# Format: starts with `sk-ant-` followed by ~95 chars
# Source: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ----- HeyGen Streaming Avatar -----
# API key source: https://app.heygen.com/settings (Subscription -> API)
# This stays server-side only (used by /api/heygen-token to mint session tokens).
HEYGEN_API_KEY=
# Avatar / voice IDs are catalog identifiers — not secrets. They run in the
# browser (the streaming SDK is client-side), so they need NEXT_PUBLIC_ prefix.
# Pick from https://app.heygen.com/streaming-avatar
NEXT_PUBLIC_HEYGEN_AVATAR_ID=
# Japanese female voice id (HeyGen voice library)
NEXT_PUBLIC_HEYGEN_VOICE_ID=

# ----- Deepgram (Speech-to-Text) -----
# Source: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ----- Notion -----
# Format: starts with `secret_`
# Source: https://www.notion.so/my-integrations
NOTION_API_KEY=
# Database IDs (UUID without dashes works too)
NOTION_INTERVIEW_DB_ID=
NOTION_JOB_DB_ID=

# ----- (Optional) ElevenLabs TTS -----
ELEVENLABS_API_KEY=

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
