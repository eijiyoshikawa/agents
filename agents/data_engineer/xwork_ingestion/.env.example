NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_ID=1ac3fae4-3499-4991-b465-e375bef7d66c

# 経産省 gBizINFO API トークン（公式URL・代表者・住所等の補完用、任意）
# 申請: https://info.gbiz.go.jp/api/index.html
GBIZ_API_TOKEN=

# Google Places API キー（電話番号・公式URL の追加補完用、任意）
# 取得: https://console.cloud.google.com で Places API (New) を有効化
# 料金: $0.032/件、新規プロジェクトに $200/月クレジット付与（約6,000件/月無料）
GOOGLE_PLACES_API_KEY=

# Google Custom Search API（公式URL補完の無料代替、任意）
# 100 queries/日まで無料、超過分 $5/1000
# セットアップ:
# 1. https://programmablesearchengine.google.com で CSE 作成（ウェブ全体検索）
# 2. GCP コンソールで「Custom Search API」を有効化
# 3. API キー（Places API と共用可）と CSE ID を取得
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
