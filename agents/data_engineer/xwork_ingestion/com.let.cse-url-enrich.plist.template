<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.let.cse-url-enrich</string>

    <!-- 毎日 09:00 JST に実行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 実行コマンド: .env を読み込んで Python スクリプト実行 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "REPLACE_WITH_REPO_PATH/agents/data_engineer/xwork_ingestion" &amp;&amp; source .venv/bin/activate &amp;&amp; export $(grep -v '^#' .env | xargs) &amp;&amp; python enrich_urls_cse.py --industry 建設 --apply</string>
    </array>

    <!-- ログ -->
    <key>StandardOutPath</key>
    <string>REPLACE_WITH_REPO_PATH/agents/data_engineer/xwork_ingestion/cse_enrich.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_REPO_PATH/agents/data_engineer/xwork_ingestion/cse_enrich.err.log</string>

    <!-- ネットワーク必要 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
