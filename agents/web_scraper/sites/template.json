{
  "site_name": "サイト名を入力",
  "description": "このサイトの概要説明",
  "login_url": "https://example.com/login",
  "credentials_env": {
    "username": "SITE_EXAMPLE_USERNAME",
    "password": "SITE_EXAMPLE_PASSWORD"
  },
  "selectors": {
    "username_field": "#email",
    "password_field": "#password",
    "login_button": "button[type=submit]",
    "login_success_indicator": ".dashboard, .my-page"
  },
  "target_pages": [
    {
      "name": "ページ名（例: 求人一覧）",
      "url": "https://example.com/dashboard/listings",
      "description": "このページから取得する情報の説明",
      "extract_fields": [
        {
          "name": "title",
          "description": "項目タイトル",
          "required": true
        },
        {
          "name": "company_name",
          "description": "企業名",
          "required": false
        },
        {
          "name": "details",
          "description": "詳細情報（テキスト全体）",
          "required": true
        }
      ],
      "pagination": {
        "enabled": false,
        "next_button_selector": ".pagination .next",
        "max_pages": 5
      }
    }
  ],
  "category": "求人",
  "tos_status": "allowed",
  "tos_notes": "利用規約に関する確認事項をここに記載。allowed / restricted / api_available のいずれかを tos_status に設定",
  "api_endpoint": null,
  "api_auth_type": null,
  "rate_limit": {
    "min_interval_seconds": 3,
    "max_requests_per_session": 50,
    "pause_after_n_requests": 10,
    "pause_duration_seconds": 10
  },
  "notes": "その他の注意事項"
}
