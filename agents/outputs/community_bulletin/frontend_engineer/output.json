  "performance": {
    "lcp": "< 2.5s (target)",
    "fid": "< 100ms (target)",
    "cls": "< 0.1 (target)",
    "strategies": [
      "Server Componentsをデフォルトに。Client Componentsは対話が必要な箇所のみ",
      "画像はnext/image + Supabase Storage CDNで最適化",
      "フォントはnext/fontでNoto Sans JPをサブセット化（CJK文字最適化）",
      "Service Workerでオフライン閲覧対応（PWA）",
      "Route Groupsで認証ページと本体ページのバンドルを分離",
      "Suspenseでストリーミングレンダリング（回覧板フィードのローディングUX改善）"
    ]
  },
  "pwa_config": {
    "manifest": {
      "name": "まちボード",
      "short_name": "まちボード",
      "theme_color": "#2980B9",
      "background_color": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait",
      "start_url": "/",
      "icons": ["192x192", "512x512"]
    },
    "service_worker": {
      "caching_strategy": "Network-first for API, Cache-first for static assets",
      "offline_page": "最後に取得した回覧板一覧をIndexedDBからオフライン表示"
    }
  }
