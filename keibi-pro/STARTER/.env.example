# ── 警備Pro 環境変数サンプル ──
# 本ファイルを .env にコピーして値を設定。シークレットはコミットしないこと。

# アプリ
NODE_ENV=development
APP_URL=http://localhost:3000

# データベース（PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/keibipro?schema=public

# 認証（NextAuth等）
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=__change_me__
SESSION_SECRET=__change_me__

# マルチテナント
DEFAULT_TENANT=__optional__

# Google Drive 連携（日報写真の保存・控え送信）
# サービスアカウント or OAuth クライアント
GOOGLE_DRIVE_PARENT_FOLDER_ID=__drive_folder_id__
GOOGLE_SERVICE_ACCOUNT_EMAIL=__service_account_email__
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OAuth を使う場合
GOOGLE_OAUTH_CLIENT_ID=__optional__
GOOGLE_OAUTH_CLIENT_SECRET=__optional__

# メール（請求書/日報控えの送信）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="警備Pro <noreply@example.com>"

# 通知（任意：LINE連携）
LINE_CHANNEL_ACCESS_TOKEN=__optional__
LINE_CHANNEL_SECRET=__optional__

# ストレージ/ログ
LOG_LEVEL=info

# AI（任意：将来のアシスタント/分析・docs/06 Phase4）
ANTHROPIC_API_KEY=__optional__

# 帳票（PDF生成）
PDF_RENDERER=server   # server | external
